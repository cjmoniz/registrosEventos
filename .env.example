# Copiar a .env (local) y cargar las mismas variables en Vercel > Settings > Environment Variables.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase > Project Settings > API > service_role. SOLO servidor, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Secretos aleatorios largos:  openssl rand -hex 32
SESSION_SECRET=
# Si cambias PIN_PEPPER, todos los PIN existentes dejan de funcionar.
PIN_PEPPER=
# Zona horaria para fechas del CSV
TZ_EVENTO=America/Caracas
